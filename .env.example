# ==========================================
# BARA-IOT ENVIRONMENT CONFIGURATION
# ==========================================

# Wi-Fi Credentials
WIFI_SSID=YOUR_WIFI_SSID
WIFI_PASSWORD=YOUR_WIFI_PASSWORD

# MQTT Broker Settings
MQTT_BROKER_HOST=192.168.1.100
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=bara-iot-water-node
MQTT_USERNAME=
MQTT_PASSWORD=

# MQTT Topics
MQTT_TOPIC_TELEMETRY=home/water/telemetry
MQTT_TOPIC_STATE=home/water/state
MQTT_TOPIC_STATUS=home/water/status

# Water Tank Geometry & Thresholds
TANK_TOTAL_DEPTH_CM=120.0
TANK_SENSOR_OFFSET_MIN_CM=20.0
TANK_THRESHOLD_LOW_PERCENT=20.0
TANK_THRESHOLD_HIGH_PERCENT=90.0
TELEMETRY_INTERVAL_MS=3000
